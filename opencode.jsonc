{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/space-bunny-free",
  "default_agent": "coordinator",

  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*VERIFICATION.md", "effect": "deny" },
    { "action": "edit", "resource": "*.goal-complete", "effect": "deny" },

    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    }
  ],

  "agents": {
    "build": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*/.goal-complete",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/VERIFICATION.md",
          "effect": "deny"
        }
      ]
    }
  }
}
