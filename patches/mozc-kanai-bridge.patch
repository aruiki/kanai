+void ConfigurePrivateInput(mozc::commands::Input* input) {
+  // KanaAI owns learning and privacy decisions.  Keep this bridge's isolated
+  // Mozc session incognito even if an upstream default config enables history
+  // or user-dictionary suggestions.
+  input->mutable_request()->set_is_incognito_mode(true);
+  auto* config = input->mutable_config();
+  config->set_incognito_mode(true);
+  config->set_history_learning_level(mozc::config::Config::NO_HISTORY);
+  config->set_use_history_suggest(false);
+}
+
+void AppendJsonString(std::string* output, std::string_view value) {
+  constexpr char kHex[] = "0123456789ABCDEF";
+  output->push_back('"');
+  for (unsigned char character : value) {
+    switch (character) {
+      case '"':
+        output->append("\\\"");
+        break;
+      case '\\':
+        output->append("\\\\");
+        break;
+      case '\b':
+        output->append("\\b");
+        break;
+      case '\f':
+        output->append("\\f");
+        break;
+      case '\n':
+        output->append("\\n");
+        break;
+      case '\r':
+        output->append("\\r");
+        break;
+      case '\t':
+        output->append("\\t");
+        break;
+      default:
+        if (character < 0x20) {
+          output->append("\\u00");
+          output->push_back(kHex[character >> 4]);
+          output->push_back(kHex[character & 0x0f]);
+        } else {
+          // JSON permits non-ASCII UTF-8 bytes unchanged. Keeping them intact
+          // is important for Japanese text and avoids lossy \uXXXX conversion.
+          output->push_back(static_cast<char>(character));
+        }
+        break;
+    }
+  }
+  output->push_back('"');
+}
+
+class JsonArray {
+ public:
+  JsonArray() = default;
+
+  void AddString(std::string_view value) {
+    AddSeparator();
+    AppendJsonString(&value_, value);
+  }
+
+  void AddRaw(std::string_view value) {
+    AddSeparator();
+    value_.append(value.data(), value.size());
+  }
+
+  std::string Finish() const { return "[" + value_ + "]"; }
+
+ private:
+  void AddSeparator() {
+    if (!value_.empty()) {
+      value_.push_back(',');
+    }
+  }
+
+  std::string value_;
+};
+
+class JsonObject {
+ public:
+  JsonObject() : value_("{") {}
+
+  void AddBool(const char* key, bool value) {
+    AddKey(key);
+    value_.append(value ? "true" : "false");
+  }
+
+  void AddInt(const char* key, int32_t value) {
+    AddKey(key);
+    value_.append(std::to_string(value));
+  }
+
+  void AddUint(const char* key, uint64_t value) {
+    AddKey(key);
+    value_.append(std::to_string(value));
+  }
+
+  void AddString(const char* key, std::string_view value) {
+    AddKey(key);
+    AppendJsonString(&value_, value);
+  }
+
+  void AddNull(const char* key) {
+    AddKey(key);
+    value_.append("null");
+  }
+
+  void AddArray(const char* key, std::string_view value) {
+    AddKey(key);
+    value_.append(value.data(), value.size());
+  }
+
+  std::string Finish() const { return value_ + "}"; }
+
+ private:
+  void AddKey(const char* key) {
+    if (value_.size() > 1) {
+      value_.push_back(',');
+    }
+    value_.push_back('"');
+    value_.append(key);
+    value_.append("\":");
+  }
+
+  std::string value_;
+};
+
+int HexValue(char character) {
+  if (character >= '0' && character <= '9') {
+    return character - '0';
+  }
+  if (character >= 'a' && character <= 'f') {
+    return character - 'a' + 10;
+  }
+  if (character >= 'A' && character <= 'F') {
+    return character - 'A' + 10;
+  }
+  return -1;
+}
+
+bool DecodePercentEncoded(std::string_view input, std::string* output,
+                          std::string* error) {
+  output->clear();
+  output->reserve(input.size());
+
+  for (size_t index = 0; index < input.size();) {
+    if (input[index] != '%') {
+      output->push_back(input[index++]);
+      continue;
+    }
+    if (index + 2 >= input.size()) {
+      *error = "incomplete percent escape at byte " + std::to_string(index);
+      return false;
+    }
+    const int high = HexValue(input[index + 1]);
+    const int low = HexValue(input[index + 2]);
+    if (high < 0 || low < 0) {
+      *error = "invalid percent escape at byte " + std::to_string(index);
+      return false;
+    }
+    output->push_back(static_cast<char>((high << 4) | low));
+    index += 3;
+  }
+
+  if (!mozc::strings::IsValidUtf8(
+          absl::string_view(output->data(), output->size()))) {
+    *error = "percent-encoded value is not valid UTF-8";
+    return false;
+  }
+  return true;
+}
+
+std::vector<std::string_view> SplitTabs(std::string_view line) {
+  std::vector<std::string_view> fields;
+  size_t begin = 0;
+  while (true) {
+    const size_t separator = line.find('\t', begin);
+    if (separator == std::string_view::npos) {
+      fields.push_back(line.substr(begin));
+      return fields;
+    }
+    fields.push_back(line.substr(begin, separator - begin));
+    begin = separator + 1;
+  }
+}
+
+bool DecodeFields(std::string_view line, std::vector<std::string>* fields,
+                  std::string* error) {
+  fields->clear();
+  for (const std::string_view field : SplitTabs(line)) {
+    std::string decoded;
+    if (!DecodePercentEncoded(field, &decoded, error)) {
+      return false;
+    }
+    fields->push_back(std::move(decoded));
+  }
+  return true;
+}
+
+bool HasControlCharacter(std::string_view value) {
+  for (const unsigned char character : value) {
+    if (character < 0x20 || character == 0x7f) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ValidateTextField(std::string_view value, size_t max_bytes,
+                       bool allow_empty, const char* name,
+                       std::string* error) {
+  if ((!allow_empty && value.empty()) || value.size() > max_bytes) {
+    *error = std::string(name) + " is empty or too large";
+    return false;
+  }
+  if (HasControlCharacter(value)) {
+    *error = std::string(name) + " contains a control character";
+    return false;
+  }
+  return true;
+}
+
+bool ParseInt32(std::string_view text, int32_t* value) {
+  if (text.empty()) {
+    return false;
+  }
+  int64_t parsed = 0;
+  const char* begin = text.data();
+  const char* end = begin + text.size();
+  const auto result = std::from_chars(begin, end, parsed, 10);
+  if (result.ec != std::errc() || result.ptr != end ||
+      parsed < std::numeric_limits<int32_t>::min() ||
+      parsed > std::numeric_limits<int32_t>::max()) {
+    return false;
+  }
+  *value = static_cast<int32_t>(parsed);
+  return true;
+}
+
+bool ParseUint64(std::string_view text, uint64_t* value) {
+  if (text.empty()) {
+    return false;
+  }
+  uint64_t parsed = 0;
+  const char* begin = text.data();
+  const char* end = begin + text.size();
+  const auto result = std::from_chars(begin, end, parsed, 10);
+  if (result.ec != std::errc() || result.ptr != end) {
+    return false;
+  }
+  *value = parsed;
+  return true;
+}
+
+bool ConfigureProfile(int argc, char** argv, std::string* error) {
+  std::string profile;
+  constexpr std::string_view kProfilePrefix = "--profile=";
+  for (int index = 1; index < argc; ++index) {
+    const std::string_view argument(argv[index]);
+    if (argument == "--profile") {
+      if (index + 1 >= argc) {
+        *error = "--profile requires a directory";
+        return false;
+      }
+      profile = argv[++index];
+    } else if (argument.rfind(kProfilePrefix, 0) == 0) {
+      profile = argument.substr(kProfilePrefix.size());
+    }
+  }
+
+  if (profile.empty()) {
+    return true;
+  }
+
+  std::error_code filesystem_error;
+  std::filesystem::create_directories(profile, filesystem_error);
+  if (filesystem_error) {
+    *error =
+        "failed to create profile directory: " + filesystem_error.message();
+    return false;
+  }
+  if (!std::filesystem::is_directory(profile, filesystem_error) ||
+      filesystem_error) {
+    *error = "profile path is not a directory: " + profile;
+    return false;
+  }
+  mozc::SystemUtil::SetUserProfileDirectory(profile);
+  return true;
+}
