+std::string PreeditText(const mozc::commands::Output& output) {
+  std::string preedit;
+  if (!output.has_preedit()) {
+    return preedit;
+  }
+  for (const auto& segment : output.preedit().segment()) {
+    preedit.append(segment.value());
+  }
+  return preedit;
+}
+
+std::string ReadingFromOutput(const mozc::commands::Output& output) {
+  std::string reading;
+  if (output.has_preedit()) {
+    for (const auto& segment : output.preedit().segment()) {
+      reading.append(segment.has_key() ? segment.key() : segment.value());
+    }
+  }
+  return reading;
+}
+
+std::string CategoryName(mozc::commands::Category category) {
+  switch (category) {
+    case mozc::commands::CONVERSION:
+      return "conversion";
+    case mozc::commands::PREDICTION:
+      return "prediction";
+    case mozc::commands::SUGGESTION:
+      return "suggestion";
+    case mozc::commands::TRANSLITERATION:
+      return "transliteration";
+    case mozc::commands::USAGE:
+      return "usage";
+  }
+  return "unknown";
+}
+
+const char* AttributeName(mozc::commands::CandidateAttribute attribute) {
+  switch (attribute) {
+    case mozc::commands::USER_DICTIONARY:
+      return "userDictionary";
+    case mozc::commands::USER_HISTORY:
+      return "userHistory";
+    case mozc::commands::SPELLING_CORRECTION:
+      return "spellingCorrection";
+    case mozc::commands::TYPING_CORRECTION:
+      return "typingCorrection";
+    case mozc::commands::DELETABLE:
+      return "deletable";
+    case mozc::commands::DEFAULT_ATTRIBUTE:
+      return "default";
+  }
+  return "unknown";
+}
+
+JsonObject MakeCandidateObject(
+    const mozc::commands::CandidateWord& candidate,
+    mozc::commands::Category category) {
+  JsonObject object;
+  object.AddInt("id", candidate.id());
+  // Mozc's protocol index is zero based. The line protocol exposes the
+  // human-facing one-based candidate number while keeping id stable for commit.
+  object.AddUint("index", static_cast<uint64_t>(candidate.index()) + 1);
+  object.AddString("value", candidate.value());
+  if (candidate.has_key()) {
+    object.AddString("key", candidate.key());
+  } else {
+    object.AddNull("key");
+  }
+
+  if (candidate.has_annotation() && candidate.annotation().has_description()) {
+    object.AddString("description", candidate.annotation().description());
+  } else {
+    object.AddNull("description");
+  }
+
+  JsonArray attributes;
+  for (const int attribute : candidate.attributes()) {
+    attributes.AddString(AttributeName(
+        static_cast<mozc::commands::CandidateAttribute>(attribute)));
+  }
+  object.AddArray("attributes", attributes.Finish());
+  object.AddString("source", CategoryName(category));
+  if (candidate.has_log()) {
+    object.AddString("log", candidate.log());
+  }
+  return object;
+}
+
+JsonObject MakeWindowCandidateObject(
+    const mozc::commands::CandidateWindow::Candidate& candidate,
+    mozc::commands::Category category) {
+  JsonObject object;
+  object.AddInt("id", candidate.id());
+  object.AddUint("index", static_cast<uint64_t>(candidate.index()) + 1);
+  object.AddString("value", candidate.value());
+  object.AddNull("key");
+  if (candidate.has_annotation() && candidate.annotation().has_description()) {
+    object.AddString("description", candidate.annotation().description());
+  } else {
+    object.AddNull("description");
+  }
+  object.AddArray("attributes", "[]");
+  object.AddString("source", CategoryName(category));
+  return object;
+}
+
+void AddCandidateFields(JsonObject* response,
+                        const mozc::commands::Output& output) {
+  const mozc::commands::CandidateList* all_candidates = nullptr;
+  if (output.has_all_candidate_words() &&
+      output.all_candidate_words().candidates_size() > 0) {
+    all_candidates = &output.all_candidate_words();
+  }
+
+  JsonArray candidates;
+  if (all_candidates != nullptr) {
+    const mozc::commands::Category category = all_candidates->category();
+    for (const auto& candidate : all_candidates->candidates()) {
+      candidates.AddRaw(MakeCandidateObject(candidate, category).Finish());
+    }
+  } else if (output.has_candidate_window() &&
+             output.candidate_window().candidate_size() > 0) {
+    const auto& candidate_window = output.candidate_window();
+    const mozc::commands::Category category = candidate_window.category();
+    for (const auto& candidate : candidate_window.candidate()) {
+      candidates.AddRaw(
+          MakeWindowCandidateObject(candidate, category).Finish());
+    }
+  }
+  response->AddArray("candidates", candidates.Finish());
+}
+
+void AddStateFields(JsonObject* response,
+                    const mozc::commands::Output& output,
+                    uint64_t elapsed_micros, bool default_consumed) {
+  response->AddString("preedit", PreeditText(output));
+
+  JsonArray preedit_segments;
+  if (output.has_preedit()) {
+    for (const auto& segment : output.preedit().segment()) {
+      JsonObject item;
+      item.AddString("value", segment.value());
+      if (segment.has_key()) {
+        item.AddString("key", segment.key());
+      } else {
+        item.AddNull("key");
+      }
+      item.AddBool("highlighted",
+                   segment.annotation() ==
+                       mozc::commands::Preedit::Segment::HIGHLIGHT);
+      preedit_segments.AddRaw(item.Finish());
+    }
+  }
+  response->AddArray("preeditSegments", preedit_segments.Finish());
+  AddCandidateFields(response, output);
+
+  std::optional<uint32_t> focused_index;
+  if (output.has_all_candidate_words() &&
+      output.all_candidate_words().has_focused_index()) {
+    focused_index = output.all_candidate_words().focused_index();
+  } else if (output.has_candidate_window() &&
+             output.candidate_window().has_focused_index()) {
+    focused_index = output.candidate_window().focused_index();
+  }
+  if (focused_index.has_value()) {
+    response->AddUint("focusedIndex", *focused_index);
+  } else {
+    response->AddNull("focusedIndex");
+  }
+
+  response->AddBool("consumed", output.has_consumed()
+                                    ? output.consumed()
+                                    : default_consumed);
+  response->AddUint("elapsedMicros", elapsed_micros);
+}
+
+std::string MakeConvertResponse(const mozc::commands::Output& output,
+                                std::string_view reading,
+                                uint64_t elapsed_micros) {
+  JsonObject response;
+  response.AddBool("ok", true);
+  response.AddString("provider", kProvider);
+  response.AddString("detail", "converted");
+  if (reading.empty()) {
+    response.AddString("reading", PreeditText(output));
+  } else {
+    response.AddString("reading", reading);
+  }
+  AddStateFields(&response, output, elapsed_micros, true);
+  return response.Finish();
+}
+
+std::string MakeResetResponse(const mozc::commands::Output& output,
+                              uint64_t elapsed_micros) {
+  JsonObject response;
+  response.AddBool("ok", true);
+  response.AddString("provider", kProvider);
+  response.AddString("detail", "reset");
+  AddStateFields(&response, output, elapsed_micros, false);
+  return response.Finish();
+}
+
+std::string MakeCommitResponse(const mozc::commands::Output& output,
+                               uint64_t elapsed_micros) {
+  JsonObject response;
+  response.AddBool("ok", true);
+  response.AddString("provider", kProvider);
+  response.AddString("detail", "committed");
+  const std::string& text = output.result().value();
+  response.AddString("text", text);
+  // Keep both names available for small clients that use either spelling.
+  response.AddString("result", text);
+  if (output.result().has_key()) {
+    response.AddString("reading", output.result().key());
+  }
+  AddStateFields(&response, output, elapsed_micros, true);
+  return response.Finish();
+}
+
+uint64_t ElapsedMicros(std::chrono::steady_clock::time_point begin) {
+  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now() - begin);
+  return static_cast<uint64_t>(elapsed.count());
+}
