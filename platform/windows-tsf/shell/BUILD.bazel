load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Keep the optional seam explicitly x64.  This is a console executable, not a
# TSF DLL, and is never registered with the Text Services Framework.
platform(
    name = "windows-x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_binary(
    name = "kanai_windows_shell_bridge",
    srcs = ["kanai_windows_shell_bridge.cpp"],
    hdrs = ["kanai_shell_bridge.h"],
    copts = [
        "/std:c++20",
        "/utf-8",
        "/DWIN32_LEAN_AND_MEAN",
        "/DNOMINMAX",
    ],
    linkopts = ["-DEFAULTLIB:winhttp.lib"],
    target_compatible_with = ["@platforms//os:windows"],
    tags = ["manual"],
)
