Windows Registry Editor Version 5.00

; KanaAI TSF machine-wide administrator registration template (x64).
; SOURCE-ONLY: do not import this file as-is. It contains the sentinel
; @@TIP_DLL_PATH@@ and does not prove that TSF registration is complete.
;
; Render this template only from a 64-bit elevated PowerShell/reg.exe. The
; corresponding registry view is Registry64 (reg.exe /reg:64). Program Files is the default
; x64 location; the installer resolves ProgramW6432 (falling back to
; ProgramFiles) rather than hard-coding C:\Program Files.
;
; The rendered default path is
; %ProgramW6432%\KanaAI\TSF\KanaAI.TsfTip.dll, but the registry value must
; contain the resolved absolute path rather than an unexpanded variable.
;
; The machine TIP/provider keys are written below. Current-user activation is a
; separate operation and should be performed by InstallLayoutOrTip or the
; reviewed installer after the real TIP has passed Windows tests.

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{7E7B5C1E-6D3A-4F2C-9A0E-3F4B5D6C7E81}]
@="KanaAI Japanese input processor"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{7E7B5C1E-6D3A-4F2C-9A0E-3F4B5D6C7E81}\InProcServer32]
@="@@TIP_DLL_PATH@@"
"ThreadingModel"="Apartment"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{7E7B5C1E-6D3A-4F2C-9A0E-3F4B5D6C7E81}]
"Description"="KanaAI Japanese input processor"
"EnableCompartment"=dword:00000001
"LoadBehavior"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{7E7B5C1E-6D3A-4F2C-9A0E-3F4B5D6C7E81}\LanguageProfile\0x00000411\{F3C2B7A1-6D54-4E8B-9A10-2C7D8E9F0A12}]
"Description"="KanaAI Japanese"
; LANGID 0x0411 is represented as the 0x00000411 registry segment.
; The API spelling is ...\LanguageProfile\0x0411\{PROFILE_GUID}.
"Language"=dword:00000411
"IconFile"="@@TIP_DLL_PATH@@"
"IconIndex"=dword:00000000

; Categories are registered through ITfCategoryMgr, not by guessing a
; registry value. The future TIP registrar must unregister them on removal.
