# KanaAI Windows beta runtime configuration template.
# Copy this file to %LOCALAPPDATA%\KanaAI\config\kanai.env and edit the copy.
# The packaged template is deliberately secret-free.
#
# Format: KEY=VALUE. Blank values disable optional settings. The launcher
# expands __PACKAGE_ROOT__ and __USER_DATA__ only; it does not execute a
# shell or interpolate arbitrary PowerShell expressions.

KANAI_PORT=8787
KANAI_MOZC_BRIDGE=__PACKAGE_ROOT__\bin\kanai-mozc-bridge.exe
KANAI_MOZC_PROFILE=__USER_DATA__\mozc

# Optional local OpenAI-compatible server. No model is bundled.
KANA_AI_BASE_URL=http://127.0.0.1:8080/v1
KANA_AI_MODEL=
KANA_AI_API_KEY=
KANA_AI_ALLOW_REMOTE=0

KANAI_DIAGNOSTICS=0
