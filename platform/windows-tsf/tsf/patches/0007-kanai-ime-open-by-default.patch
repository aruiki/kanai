+HResultOr<bool> TipStatus::GetAndEnsureIMEOpen(ITfThreadMgr* thread_mgr,
+                                               TfClientId client_id,
+                                               bool default_open) {
+  wil::unique_variant default_var;
+  default_var.vt = VT_I4;
+  default_var.lVal = default_open ? TRUE : FALSE;
+
+  // GetAndEnsureDataExists writes |default_var| only when the compartment holds
+  // no data yet, and returns the stored value otherwise. That is what keeps a
+  // user who has closed the IME from having it reopened on every activation.
+  HResultOr<wil::unique_variant> var =
+      TipCompartmentUtil::GetAndEnsureDataExists(
+          thread_mgr, GUID_COMPARTMENT_KEYBOARD_OPENCLOSE, client_id,
+          std::move(default_var));
+  if (!var.has_value()) {
+    return HResultFail();
+  }
+  if (var->vt != VT_I4) {
+    return HResultFail();
+  }
+  // HResultOk, not a bare bool: hresultor.h documents that direct
+  // initialisation of an HResultOr from a type convertible to HRESULT is
+  // ambiguous, and bool is. A bare `return expr;` here is error C2440, which
+  // this build reported before HResultOk was used.
+  return HResultOk(var->lVal != FALSE);
+}
