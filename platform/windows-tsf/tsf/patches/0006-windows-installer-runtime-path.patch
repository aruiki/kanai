+// Deferred MSI actions can read CustomActionData, not INSTALLFOLDER.
+// The package supplies the resolved directory separately for each action.
+std::wstring GetInstallerComponentPath(MSIHANDLE msi,
+                                       absl::string_view filename) {
+  const std::wstring directory = GetProperty(msi, L"CustomActionData");
+  if (directory.empty()) {
+    return {};
+  }
+  return directory + L"\\" + mozc::win32::Utf8ToWide(filename);
+}
