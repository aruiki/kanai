+#ifdef _WIN32
+void UpdateKanaAiSessionBinding(const commands::Input& input) {
+  if (!input.has_id() || input.id() == 0) {
+    return;
+  }
+  if (input.type() == commands::Input::CREATE_SESSION ||
+      input.type() == commands::Input::DELETE_SESSION) {
+    kanai::tsf::KanaAiSupplementalModel::EndMozcSession(input.id());
+    return;
+  }
+  if (input.type() != commands::Input::SEND_KEY &&
+      input.type() != commands::Input::SEND_COMMAND) {
+    return;
+  }
+  auto field_class = kanai::tsf::KanaAiSessionFieldClass::kRegular;
+  if (input.has_context() &&
+      input.context().input_field_type() == commands::Context::PASSWORD) {
+    field_class = kanai::tsf::KanaAiSessionFieldClass::kPassword;
+  }
+  if (input.has_context()) {
+    for (const std::string& feature : input.context().experimental_features()) {
+      if (feature == "kanai.protected") {
+        field_class = kanai::tsf::KanaAiSessionFieldClass::kProtected;
+        break;
+      }
+    }
+  }
+  (void)kanai::tsf::KanaAiSupplementalModel::BeginMozcCommand(input.id(),
+                                                               field_class);
+}
+#endif  // _WIN32
