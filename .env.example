# KanaAI local service
KANAI_PORT=8787

# Optional local OpenAI-compatible server (llama.cpp default: http://127.0.0.1:8080/v1)
KANA_AI_BASE_URL=http://127.0.0.1:8080/v1
KANA_AI_MODEL=
# Usually not required for llama.cpp. Never commit a real key.
KANA_AI_API_KEY=
# Remote endpoints are disabled unless explicitly enabled.
KANA_AI_ALLOW_REMOTE=0

# Keep bridge diagnostics off in normal operation.
KANAI_DIAGNOSTICS=0

# Optional isolated Mozc profile. Defaults to .local/share/kanai/mozc.
KANAI_MOZC_PROFILE=
# Optional explicit path to the patched Mozc bridge binary.
KANAI_MOZC_BRIDGE=
